# moyeo 운영 환경 변수 예시(Task 067). cp .env.example .env 후 값을 채운다. .env는 커밋하지 않는다(gitignore)
# 생성법·설명은 docs/DEPLOY.md 참고

# 서비스 도메인(Caddy 인증서 발급 대상)과 공개 주소. 초대·모임·공유(OG) 링크와 카카오 Redirect URI가 이 주소로 만들어진다
APP_DOMAIN=moyeo.example.com
APP_BASE_URL=https://moyeo.example.com

# MySQL
MYSQL_DATABASE=moyeo
MYSQL_USER=moyeo
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# 카카오(REST API 키 = client-id). Redirect URI는 compose가 APP_BASE_URL/api/auth/kakao/callback으로 넣는다
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# 장소 검색 키를 따로 쓸 때만 주석을 푼다. 빈 값으로 두면 KAKAO_CLIENT_ID로 대체되지 않고 빈 키가 되니 주의
#KAKAO_REST_API_KEY=

# 자체 JWT 서명 키(32바이트 이상): openssl rand -base64 48
JWT_SECRET=

# 계좌번호 암호화 키(Base64 32바이트): openssl rand -base64 32 — 잃으면 저장된 계좌번호를 복구할 수 없다. 따로 백업한다
PAYMENT_ENCRYPTION_KEY=

# 웹 푸시 VAPID 키(npx web-push generate-vapid-keys). 비우면 푸시만 꺼진다
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@moyeo.example.com

# 같은 도메인 배포라 보통 비운다(다른 오리진에서 WebSocket을 열 때만 쉼표로)
WS_ALLOWED_ORIGINS=
