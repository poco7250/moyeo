# moyeo 리버스 프록시(Task 067, PRD 오픈 이슈 1 종결: 같은 도메인 배포)
# /api · /ws · /share 는 Spring으로, 나머지는 React(Vite) SPA 정적 파일로 보낸다
# Caddy가 Let's Encrypt 인증서를 자동 발급·갱신하고 X-Forwarded-Proto/For/Host와 WebSocket 업그레이드를 기본 처리한다
# APP_DOMAIN=localhost면 Caddy 내부 CA로 로컬 https를 연다(로컬 점검용)
# /actuator는 넘기지 않는다(헬스 체크는 compose 내부에서만)

{$APP_DOMAIN} {
	encode zstd gzip

	# 영수증 사진 10MB + multipart 여유분(스프링 max-request-size 11MB보다 약간 크게)
	request_body {
		max_size 12MB
	}

	# 헬스 체크 엔드포인트는 밖으로 열지 않는다(SPA로도 넘기지 않고 404)
	handle /actuator* {
		respond 404
	}

	@backend path /api/* /ws /ws/* /share/*
	handle @backend {
		reverse_proxy app:8080
	}

	handle {
		root * /srv/frontend
		# SPA 라우팅: 없는 경로(/invites/abc 등)는 index.html로
		try_files {path} /index.html
		file_server
	}
}
